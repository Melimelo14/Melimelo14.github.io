}],"l":""},"c":[]}}}}}},"2e71777a-e26d-4a26-8e1b-584ba295d421":{"value":{"id":"2e71777a-e26d-4a26-8e1b-584ba295d421","version":895,"type":"text","properties":{"title":[["En MTC, on considère qu’une grande partie, si ce n’est la majorité, des troubles classiques rencontrés dans la petite enfance sont liés à l’alimentation. Je ne peux donc que vous encourager à vous pencher sur le sujet ! "]]},"created_time":1709646348040,"last_edited_time":1709646629988,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"Gyf73hJGsGL5L7e0VBCb3A,\"start\",\"end\"","n":{"Gyf73hJGsGL5L7e0VBCb3A,\"start\",\"end\"":{"s":{"x":"Gyf73hJGsGL5L7e0VBCb3A","i":[{"t":"s"},{"t":"t","i":["tPNQFXrqRWFR",1],"o":"start","l":220,"c":"En MTC, on considère qu’une grande partie, si ce n’est la majorité, des troubles classiques rencontrés dans la petite enfance sont liés à l’alimentation. Je ne peux donc que vous encourager à vous pencher sur le sujet ! "},{"t":"e"}],"l":""},"c":[]}}}}}},"38113cdf-37c8-4d44-ae87-a7371a7f8063":{"value":{"id":"38113cdf-37c8-4d44-ae87-a7371a7f8063","version":16,"type":"text","properties":{"title":[["Et ceci va bien au-delà des troubles cités ci-avant : on peut aussi inclure en grande partie les troubles du sommeil, l’agitation et les colères, les troubles cutanés, les otites à répétition…"]]},"created_time":1709646629988,"last_edited_time":1709646633061,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"MbCml-0Te4vjCmUZAOJzhQ,\"start\",\"end\"","n":{"MbCml-0Te4vjCmUZAOJzhQ,\"start\",\"end\"":{"s":{"x":"MbCml-0Te4vjCmUZAOJzhQ","i":[{"t":"s"},{"t":"t","i":["64zCW2E5mpGo",1],"o":"start","l":192,"c":"Et ceci va bien au-delà des troubles cités ci-avant : on peut aussi inclure en grande partie les troubles du sommeil, l’agitation et les colères, les troubles cutanés, les otites à répétition…"},{"t":"e"}],"l":""},"c":[]}}}}}},"1057c112-af51-4364-b2cc-6f5cbb500c4d":{"value":{"id":"1057c112-af51-4364-b2cc-6f5cbb500c4d","version":4,"type":"text","created_time":1709645617742,"last_edited_time":1709646326941,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"RCvx0YFg7qvht5A2UwFMOw,\"start\",\"end\"","n":{"RCvx0YFg7qvht5A2UwFMOw,\"start\",\"end\"":{"s":{"x":"RCvx0YFg7qvht5A2UwFMOw","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}}},"aa7ccdf6-8a47-48a1-86dc-3dc1d12d4220":{"value":{"id":"aa7ccdf6-8a47-48a1-86dc-3dc1d12d4220","version":28,"type":"text","properties":{"title":[["Que faire ?",[["b"]]]]},"created_time":1709645617742,"last_edited_time":1709648507348,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"JxF9hq1KLqDkIYnBWC90sA,\"start\",\"end\"","n":{"JxF9hq1KLqDkIYnBWC90sA,\"start\",\"end\"":{"s":{"x":"JxF9hq1KLqDkIYnBWC90sA","i":[{"t":"s"},{"t":"t","i":["xCj84Q-_NS2G",1],"o":"start","l":11,"c":"Que faire ?","b":[{"t":"a","x":"JxF9hq1KLqDkIYnBWC90sA","l":"","i":["xCj84Q-_NS2G",12],"s":{"i":["xCj84Q-_NS2G",1],"a":"b"},"e":{"i":"end","a":"b"},"a":["b"]}]},{"t":"e","b":[]}],"l":""},"c":[]}}}}}},"82e5a9f5-d16e-4c7c-b06b-10937e80d7ae":{"value":{"id":"82e5a9f5-d16e-4c7c-b06b-10937e80d7ae","version":855,"type":"bulleted_list","properties":{"title":[["En diététique chinoise : veiller à l’alimentation de la mère allaitante, au choix du lait maternisé ou à l’alimentation du bébé diversifié. On privilégie le cuit, chaud, facile à digérer et on évite de trop épicer, le froid ou glacé, les surplus de sucre ou gras, on limite la banane (froide, en MTC). On espace les repas d’au moins 3h (min 2h pour les tétées) pour ne pas solliciter en permanence le système digestif."]]},"created_time":1709646678822,"last_edited_time":1709647898538,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"7YRIIRrH7w1wgH7uyGp7Ww,\"start\",\"end\"","n":{"7YRIIRrH7w1wgH7uyGp7Ww,\"start\",\"end\"":{"s":{"x":"7YRIIRrH7w1wgH7uyGp7Ww","i":[{"t":"s"},{"t":"t","i":["rL9CBD_fgQpS",1],"o":"start","l":418,"c":"En diététique chinoise : veiller à l’alimentation de la mère allaitante, au choix du lait maternisé ou à l’alimentation du bébé diversifié. On privilégie le cuit, chaud, facile à digérer et on évite de trop épicer, le froid ou glacé, les surplus de sucre ou gras, on limite la banane (froide, en MTC). On espace les repas d’au moins 3h (min 2h pour les tétées) pour ne pas solliciter en permanence le système digestif."},{"t":"e"}],"l":""},"c":[]}}}}}},"4f79f7b4-9cd6-44b1-a60e-91620475e887":{"value":{"id":"4f79f7b4-9cd6-44b1-a60e-91620475e887","version":514,"type":"bulleted_list","properties":{"title":[["Avec des plantes : du gingembre sec un peu partout, dans l’alimentation ou les tisanes de maman si elle allaite, dans les biberons et plats de bébé. Sans en mettre trop pour éviter que ça pique. Ca soutient et réchauffe le système digestif."]]},"created_time":1709647907720,"last_edited_time":1709648025062,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"9v2TiIUgKVICUCxqKck9Xg,\"start\",\"end\"","n":{"9v2TiIUgKVICUCxqKck9Xg,\"start\",\"end\"":{"s":{"x":"9v2TiIUgKVICUCxqKck9Xg","i":[{"t":"s"},{"t":"t","i":["kGlUvhO0km3m",1],"o":"start","l":240,"c":"Avec des plantes : du gingembre sec un peu partout, dans l’alimentation ou les tisanes de maman si elle allaite, dans les biberons et plats de bébé. Sans en mettre trop pour éviter que ça pique. Ca soutient et réchauffe le système digestif."},{"t":"e"}],"l":""},"c":[]}}}}}},"4a22cc12-a6d5-4eaf-b83a-8e173c6f2c2a":{"value":{"id":"4a22cc12-a6d5-4eaf-b83a-8e173c6f2c2a","version":305,"type":"bulleted_list","properties":{"title":[["Avec une bouillotte sur le ventre après les repas, en veillant à ce que bébé ait toujours le ventre couvert, bien au chaud, quand il digère."]]},"created_time":1709648021511,"last_edited_time":1709648080562,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"f3PGFh_8D5enwEmalMl7eQ,\"start\",\"end\"","n":{"f3PGFh_8D5enwEmalMl7eQ,\"start\",\"end\"":{"s":{"x":"f3PGFh_8D5enwEmalMl7eQ","i":[{"t":"s"},{"t":"t","i":["AN7dqnHdusCt",1],"o":"start","l":140,"c":"Avec une bouillotte sur le ventre après les repas, en veillant à ce que bébé ait toujours le ventre couvert, bien au chaud, quand il digère."},{"t":"e"}],"l":""},"c":[]}}}}}},"9fa875a1-3450-473e-bf54-4854358dbb90":{"value":{"id":"9fa875a1-3450-473e-bf54-4854358dbb90","version":548,"type":"bulleted_list","properties":{"title":[["Avec des massages circulaires du ventre dans le sens horaire, qui aident à faire avancer les selles et gaz dans les intestins ou encore en leur faisant faire “du vélo” allongés sur le dos (alterner une jambe tendue et une bien repliée, touchant l’abdomen)."]]},"created_time":1709648128393,"last_edited_time":1709648499016,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"Rt5DfnUJ6rmXRd1xTN7QeQ,\"start\",\"end\"","n":{"Rt5DfnUJ6rmXRd1xTN7QeQ,\"start\",\"end\"":{"s":{"x":"Rt5DfnUJ6rmXRd1xTN7QeQ","i":[{"t":"s"},{"t":"t","i":["63mgSXhmPHAO",1],"o":"start","l":256,"c":"Avec des massages circulaires du ventre dans le sens horaire, qui aident à faire avancer les selles et gaz dans les intestins ou encore en leur faisant faire “du vélo” allongés sur le dos (alterner une jambe tendue et une bien repliée, touchant l’abdomen)."},{"t":"e"}],"l":""},"c":[]}}}}}},"53fac362-96a8-4dc4-8a9d-72bff58d2aec":{"value":{"id":"53fac362-96a8-4dc4-8a9d-72bff58d2aec","version":4,"type":"text","created_time":1709645617742,"last_edited_time":1709646327161,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"rpdEElRLm50Uh5wu74gn5A,\"start\",\"end\"","n":{"rpdEElRLm50Uh5wu74gn5A,\"start\",\"end\"":{"s":{"x":"rpdEElRLm50Uh5wu74gn5A","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}}},"ba438d3c-b076-4094-81f0-e1e8aad7b277":{"value":{"id":"ba438d3c-b076-4094-81f0-e1e8aad7b277","version":66,"type":"text","properties":{"title":[["Les laits maternels et maternisés ",[["b"]]]]},"created_time":1709645617742,"last_edited_time":1709648122165,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"oPYJAA5hKFGyy2wUfuoYAA,\"start\",\"end\"","n":{"oPYJAA5hKFGyy2wUfuoYAA,\"start\",\"end\"":{"s":{"x":"oPYJAA5hKFGyy2wUfuoYAA","i":[{"t":"s"},{"t":"t","i":["le2eloTMj_j6",1],"o":"start","l":34,"c":"Les laits maternels et maternisés ","b":[{"t":"a","x":"oPYJAA5hKFGyy2wUfuoYAA","l":"","i":["le2eloTMj_j6",35],"s":{"i":["le2eloTMj_j6",1],"a":"b"},"e":{"i":"end","a":"b"},"a":["b"]}]},{"t":"e","b":[]}],"l":""},"c":[]}}}}}},"59a22205-fb9a-4268-ae9f-f3041a04a539":{"value":{"id":"59a22205-fb9a-4268-ae9f-f3041a04a539","version":4,"type":"text","properties":{"title":[["Le lait maternel est, comme les études le montrent, le plus adapté aux besoins de bébé. Pour l’allaitement à la demande, la MTC considère qu’il faut tout de même espacer les tétées de 2 à 3h minimum afin d’offrir des moments de repos au système digestif. Un système digestif tout le temps saturé peut facilement générer des colères, des troubles du sommeil ou de l’agitation."]]},"format":{"use_crdt":false,"copied_from_pointer":{"id":"22fdf47a-84bc-4bad-ab5d-7ddac5aeee3f","table":"block","spaceId":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2"}},"created_time":1709645619382,"last_edited_time":1709645619395,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"copied_from":"22fdf47a-84bc-4bad-ab5d-7ddac5aeee3f","space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"55lUz4zABzpWiHT61Ed4FQ,\"start\",\"end\"","n":{"55lUz4zABzpWiHT61Ed4FQ,\"start\",\"end\"":{"s":{"x":"55lUz4zABzpWiHT61Ed4FQ","i":[{"t":"s"},{"t":"t","i":["Bc45MHHl70x7",1],"o":"start","l":375,"c":"Le lait maternel est, comme les études le montrent, le plus adapté aux besoins de bébé. Pour l’allaitement à la demande, la MTC considère qu’il faut tout de même espacer les tétées de 2 à 3h minimum afin d’offrir des moments de repos au système digestif. Un système digestif tout le temps saturé peut facilement générer des colères, des troubles du sommeil ou de l’agitation."},{"t":"e"}],"l":""},"c":[]}}}}}},"90ccadf5-c8c9-4467-9227-415187e1859b":{"value":{"id":"90ccadf5-c8c9-4467-9227-415187e1859b","version":4,"type":"text","properties":{"title":[["Cependant, toutes les mamans ne souhaitent pas ou ne peuvent pas allaiter et c’est complètement ok, il faut juste savoir s’orienter. L’idéal est alors de privilégier des laits artificiels maternisés de petits animaux (chèvre, brebis), qui sont plus digestes et de nature (principe MTC) moins froide."]]},"format":{"use_crdt":false,"copied_from_pointer":{"id":"affaf9e8-ebab-40ba-bbed-d88bdacd9434","table":"block","spaceId":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2"}},"created_time":1709645619383,"last_edited_time":1709645619395,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"copied_from":"affaf9e8-ebab-40ba-bbed-d88bdacd9434","space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"bUIDFiGIzKkx1hRzmmZOCw,\"start\",\"end\"","n":{"bUIDFiGIzKkx1hRzmmZOCw,\"start\",\"end\"":{"s":{"x":"bUIDFiGIzKkx1hRzmmZOCw","i":[{"t":"s"},{"t":"t","i":["GqVLc8G1lD8c",1],"o":"start","l":299,"c":"Cependant, toutes les mamans ne souhaitent pas ou ne peuvent pas allaiter et c’est complètement ok, il faut juste savoir s’orienter. L’idéal est alors de privilégier des laits artificiels maternisés de petits animaux (chèvre, brebis), qui sont plus digestes et de nature (principe MTC) moins froide."},{"t":"e"}],"l":""},"c":[]}}}}}},"2601a45a-2431-4b29-a5dc-4db07096342e":{"value":{"id":"2601a45a-2431-4b29-a5dc-4db07096342e","version":4,"type":"text","properties":{"title":[["Le biberon, qu’il soit de lait maternel ou maternisé, doit toujours être donné à température du corps. Le lait froid ou à température ambiante fatigue un système digestif déjà peu mature et peut générer ce qu’on appelle en MTC de l’humidité ou des glaires : un bébé un peu “bloqué”, des régurgitations, de l’agitation, un bébé qui s’énerve facilement ou a du mal à dormir."]]},"format":{"use_crdt":false,"copied_from_pointer":{"id":"6e12dea3-4d7f-4736-9a93-1e5f915692c1","table":"block","spaceId":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2"}},"created_time":1709645619383,"last_edited_time":1709645619395,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"copied_from":"6e12dea3-4d7f-4736-9a93-1e5f915692c1","space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"N3qebWX5em2U3yGTIGw3pQ,\"start\",\"end\"","n":{"N3qebWX5em2U3yGTIGw3pQ,\"start\",\"end\"":{"s":{"x":"N3qebWX5em2U3yGTIGw3pQ","i":[{"t":"s"},{"t":"t","i":["TUZ30pY9bdIa",1],"o":"start","l":372,"c":"Le biberon, qu’il soit de lait maternel ou maternisé, doit toujours être donné à température du corps. Le lait froid ou à température ambiante fatigue un système digestif déjà peu mature et peut générer ce qu’on appelle en MTC de l’humidité ou des glaires : un bébé un peu “bloqué”, des régurgitations, de l’agitation, un bébé qui s’énerve facilement ou a du mal à dormir."},{"t":"e"}],"l":""},"c":[]}}}}}},"a0a5df2e-7ed8-40bf-bac2-7904dfc545c1":{"value":{"id":"a0a5df2e-7ed8-40bf-bac2-7904dfc545c1","version":4,"type":"text","properties":{"title":[["Si bébé régurgite fréquemment, consultez des professionnels de santé pour écarter toute cause fonctionnelle (frein de langue, béance du cardia…) et tentez des changements alimentaires (changement de lait, suppression des morceaux s’il est diversifié et en DME). Les laits épaissis (”anti-régurgitations”) et les traitements médicamenteux peuvent générer de l’humidité ou des glaires, comme expliqué ci-avant, et sont donc à considérer en dernier recours."]]},"format":{"use_crdt":false,"copied_from_pointer":{"id":"0edd071e-ee99-4501-9458-690568f2dc84","table":"block","spaceId":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2"}},"created_time":1709645619384,"last_edited_time":1709645619395,"parent_id":"03028139-9a09-48f6-8d83-b2d4c01b6a1d","parent_table":"block","alive":true,"copied_from":"0edd071e-ee99-4501-9458-690568f2dc84","space_id":"bb6cb141-7c5f-42c6-8eaf-7436724e35e2","crdt_format_version":1,"crdt_data":{"title":{"r":"XmkWDsjyZcJoQGrNWLg5DA,\"start\",\"end\"","n":{"XmkWDsjyZcJoQGrNWLg5DA,\"start\",\"end\"":{"s":{"x":"XmkWDsjyZcJoQGrNWLg5DA","i":[{"t":"s"},{"t":"t","i":["pIwLs59SAp2i",1],"o":"start","l":454,"c":"Si bébé régurgite fréquemment, consultez des professionnels de santé pour écarter toute cause fonctionnelle (frein de langue, béance du cardia…) et tentez des changements alimentaires (changement de lait, suppression des morceaux s’il est diversifié et en DME). Les laits épaissis (”anti-régurgitations”) et les traitements médicamenteux peuvent générer de l’humidité ou des glaires, comme expliqué ci-avant, et sont donc à considérer en dernier recours."},{"t":"e"}],"l":""},"c":[]}}}}}},"c99143d1-b8c6-42a6-8e14-13ff0e026bb0":{"value":{"id":"c99143d1-b8c6-42a6